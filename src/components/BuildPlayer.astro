---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import DeviceFrame from './DeviceFrame.astro';
import { withBase } from '../lib/paths';
import '../styles/player.css';

interface Props {
  slug: string;
  title: string;
  orientation: 'portrait' | 'landscape' | 'both';
  poster: ImageMetadata;
  video?: string;
}

const { slug, title, orientation, poster, video } = Astro.props;
const landscape = orientation === 'landscape';
const width = landscape ? 844 : 390;
const height = landscape ? 390 : 844;
const preview = withBase(`preview.html?build=${encodeURIComponent(slug)}`);
const videoSrc = video ? withBase(video) : undefined;
---

<section
  class="player"
  id={`player-${slug}`}
  data-build-player
  data-preview={preview}
  data-orientation={orientation}
  data-title={`${title} build`}
  style={`--w:${width};--h:${height};--bezel:12px;`}
>
  <button class="player-close" type="button" data-close hidden>Close</button>
  <div class="player-stage" data-stage>
    <div class="player-fit" data-fit>
      <DeviceFrame preset="phone">
        <button class="poster-btn" type="button" data-play aria-label={`Play ${title}`}>
          <Picture
            src={poster}
            alt=""
            widths={[480, 800, 1200]}
            sizes="(max-width: 800px) 100vw, 480px"
            formats={['avif', 'webp']}
            loading="eager"
            decoding="async"
          />
          <span class="play-badge">Play</span>
        </button>
        <div class="player-loader" data-loader hidden>
          <span class="spinner" aria-hidden="true"></span>
          <p>Loading build</p>
        </div>
        <div class="player-fallback" data-fallback hidden>
          <p>This build did not load.</p>
          {
            videoSrc && (
              <video controls playsinline preload="none" src={videoSrc}></video>
            )
          }
          <button type="button" data-retry>Try again</button>
          <a href={preview} target="_blank" rel="noreferrer">Open in new tab</a>
        </div>
      </DeviceFrame>
    </div>
  </div>
  <div class="player-toolbar" role="toolbar" aria-label={`${title} player controls`}>
    <div class="control-row" role="group" aria-label="Device frame">
      <button type="button" data-preset="phone-portrait" aria-pressed={landscape ? 'false' : 'true'}>
        Portrait phone
      </button>
      <button type="button" data-preset="phone-landscape" aria-pressed={landscape ? 'true' : 'false'}>
        Landscape phone
      </button>
      <button type="button" data-preset="tablet" aria-pressed="false">Tablet</button>
    </div>
    <div class="control-row">
      <button type="button" data-restart disabled>Restart</button>
      <button type="button" data-rotate>Rotate</button>
      <button type="button" data-fullscreen aria-pressed="false">Full screen</button>
      <button type="button" data-mute disabled aria-pressed="false">Mute</button>
      <a href={preview} target="_blank" rel="noreferrer">Open in new tab</a>
    </div>
    <p class="mute-hint">Sound may play after the build starts.</p>
  </div>
  <p class="player-toast" data-toast role="status" aria-live="polite" hidden></p>
  <p class="visually-hidden" data-status aria-live="polite"></p>
  <noscript>
    <p>JavaScript is required to play this build. You can still open it in a new tab.</p>
  </noscript>
</section>

<script>
  import '../scripts/player.ts';
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
