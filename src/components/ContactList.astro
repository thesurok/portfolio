---
import { site } from '../data/site';

const links: { href: string; label: string; external: boolean }[] = [];
if (site.email) links.push({ href: `mailto:${site.email}`, label: 'Email', external: false });
if (site.linkedin) links.push({ href: site.linkedin, label: 'LinkedIn', external: true });
if (site.github) links.push({ href: site.github, label: 'GitHub', external: true });
if (site.telegram) links.push({ href: site.telegram, label: 'Telegram', external: true });
---

<ul class="contact-list">
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          rel={link.external ? 'noreferrer noopener me' : 'me'}
          target={link.external ? '_blank' : undefined}
        >
          {link.label}
        </a>
      </li>
    ))
  }
</ul>
