---
interface Chip {
  id: string;
  label: string;
}

interface Props {
  tech: Chip[];
  tags: Chip[];
}

const { tech, tags } = Astro.props;
---

<div class="filters" data-filter-bar>
  <div class="filter-row" role="group" aria-label="Technology">
    <button class="chip" type="button" data-filter="all" aria-pressed="true">All</button>
    {
      tech.map((chip) => (
        <button class="chip" type="button" data-filter={chip.id} aria-pressed="false">
          {chip.label}
        </button>
      ))
    }
  </div>
  <div class="filter-row" role="group" aria-label="Genre and mechanic">
    {
      tags.map((chip) => (
        <button class="chip" type="button" data-filter={chip.id} aria-pressed="false">
          {chip.label}
        </button>
      ))
    }
  </div>
</div>

<script>
  function applyFilter(filter: string) {
    const bar = document.querySelector<HTMLElement>('[data-filter-bar]');
    if (!bar) return;
    const known = [...bar.querySelectorAll<HTMLButtonElement>('[data-filter]')].some(
      (chip) => chip.dataset.filter === filter,
    );
    const active = known ? filter : 'all';
    bar.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((chip) => {
      chip.setAttribute('aria-pressed', String(chip.dataset.filter === active));
    });
    let shown = 0;
    document.querySelectorAll<HTMLElement>('[data-project]').forEach((card) => {
      const tech = (card.dataset.tech ?? '').split(' ').filter(Boolean);
      const tags = (card.dataset.tags ?? '').split(' ').filter(Boolean);
      const match = active === 'all' || tech.includes(active) || tags.includes(active);
      card.hidden = !match;
      if (match) shown += 1;
    });
    const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
    if (empty) empty.hidden = shown !== 0;
  }

  function bootFilters() {
    const bar = document.querySelector<HTMLElement>('[data-filter-bar]');
    if (!bar || bar.dataset.ready === 'true') return;
    bar.dataset.ready = 'true';
    bar.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-filter]');
      if (!button?.dataset.filter) return;
      const url = new URL(window.location.href);
      if (button.dataset.filter === 'all') url.searchParams.delete('filter');
      else url.searchParams.set('filter', button.dataset.filter);
      history.replaceState(null, '', url);
      applyFilter(button.dataset.filter);
    });
    const initial = new URLSearchParams(window.location.search).get('filter') ?? 'all';
    applyFilter(initial);
  }

  document.addEventListener('astro:page-load', bootFilters);
  bootFilters();
</script>
