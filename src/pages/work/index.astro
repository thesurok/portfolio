---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilterBar from '../../components/FilterBar.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { site, tagLabel, techLabels } from '../../data/site';
import { sortProjects } from '../../lib/paths';

const projects = sortProjects(await getCollection('projects'));
const tech = (['pixi', 'three'] as const)
  .filter((id) => projects.some((project) => project.data.tech.includes(id)))
  .map((id) => ({ id, label: techLabels[id] }));
const tags = [...new Set(projects.flatMap((project) => project.data.tags))]
  .sort()
  .map((id) => ({ id, label: tagLabel(id) }));
const description =
  'Interactive builds and mechanic studies: puzzle, match-3, runner, physics, 3D, and casino-style.';
---

<BaseLayout title={`Work — ${site.name}`} description={description}>
  <div class="wrap">
    <header class="page-head">
      <h1>Work</h1>
      <p class="lede">
        HTML5 games and interactive builds, tagged by genre and mechanic. Client names stay off the
        page unless a project is cleared to show.
      </p>
    </header>
    <FilterBar tech={tech} tags={tags} />
    <p class="empty-filter" data-filter-empty hidden>No projects for this filter.</p>
    <div class="project-grid">
      {projects.map((project, index) => <ProjectCard project={project} eager={index < 2} />)}
    </div>
  </div>
</BaseLayout>
