---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactList from '../components/ContactList.astro';
import { education, experience, languages, otherProjects, site, tools } from '../data/site';
import { withBase } from '../lib/paths';

const description =
  'Bio, experience, and toolset for Oleh Novytskyi, a senior JavaScript game engineer working in PixiJS and Three.js.';
---

<BaseLayout title={`About — ${site.name}`} description={description}>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">{site.role}</p>
      <h1>About</h1>
    </header>
    <div class="about-grid section">
      <p>
       I build high-performance HTML5 games and interactive applications using PixiJS and Three.js that run smoothly, alongside custom tools that help my team and me build faster and more efficiently. Looking forward to new career opportunities where my skillset can add value.
      </p>
      <p>
        <a class="btn btn-primary" href={withBase('cv.pdf')} download>Download CV (PDF)</a>
      </p>
    </div>

    <section class="section" aria-labelledby="experience-title">
      <h2 id="experience-title">Experience</h2>
      <ol class="timeline">
        {
          experience.map((item) => (
            <li>
              <p class="when">{item.period}</p>
              <h3>{item.title}</h3>
              <p class="org">{item.company}</p>
              <ul>
                {item.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section" aria-labelledby="projects-title">
      <h2 id="projects-title">Other projects</h2>
      <ul class="detail-list">
        {
          otherProjects.map((project) => (
            <li>
              <h3>{project.title}</h3>
              <p>{project.body}</p>
              {'url' in project && (
                <p>
                  <a href={project.url} rel="noreferrer noopener" target="_blank">
                    Play on YouTube
                  </a>
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="education-title">
      <h2 id="education-title">Education</h2>
      <ol class="timeline">
        {
          education.map((item) => (
            <li>
              <p class="when">{item.period}</p>
              <h3>{item.title}</h3>
              <p>
                {item.school}, {item.location}
              </p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section" aria-labelledby="languages-title">
      <h2 id="languages-title">Languages</h2>
      <ul class="tool-list">
        {languages.map((language) => (
          <li>
            {language.name} · {language.level}
          </li>
        ))}
      </ul>
    </section>

    <section class="section" aria-labelledby="tools-title">
      <h2 id="tools-title">Toolset</h2>
      <ul class="tool-list">
        {tools.map((tool) => <li>{tool}</li>)}
      </ul>
    </section>

    <section class="section contact-block" aria-labelledby="about-contact-title">
      <h2 id="about-contact-title">Contact</h2>
      <p>{site.location}.</p>
      <ContactList />
    </section>
  </div>
</BaseLayout>
